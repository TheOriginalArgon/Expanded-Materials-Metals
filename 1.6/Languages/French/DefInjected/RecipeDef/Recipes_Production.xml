<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: make charcoal -->
  <EM_Make_Charcoal.label>fabriquer du charbon de bois</EM_Make_Charcoal.label>
  <!-- EN: Incinerate wood in a closed chamber. Lack of oxygen prevents the wood from completely burning, thus making charcoal. -->
  <EM_Make_Charcoal.description>Incinérez le bois dans une chambre fermée. Le manque d'oxygène empêche le bois de brûler complètement, ce qui permet d'obtenir du charbon de bois.</EM_Make_Charcoal.description>
  <!-- EN: Making charcoal. -->
  <EM_Make_Charcoal.jobString>Fabrique du charbon de bois.</EM_Make_Charcoal.jobString>
  
  <!-- EN: make bulk charcoal -->
  <EM_Make_Charcoal_Bulk.label>fabriquer du charbon de bois (vrac)</EM_Make_Charcoal_Bulk.label>
  <!-- EN: Incinerate wood in a closed chamber. Lack of oxygen prevents the wood from completely burning, thus making charcoal. -->
  <EM_Make_Charcoal_Bulk.description>Incinérez le bois dans une chambre fermée. Le manque d'oxygène empêche le bois de brûler complètement, ce qui permet d'obtenir du charbon de bois.</EM_Make_Charcoal_Bulk.description>
  <!-- EN: Making charcoal. -->
  <EM_Make_Charcoal_Bulk.jobString>Fabrique du charbon de bois.</EM_Make_Charcoal_Bulk.jobString>
  
  <!-- EN: make chemfuel from coal -->
  <EM_Make_ChemfuelFromCoal.label>fabriquer du chemfuel à partir du charbon</EM_Make_ChemfuelFromCoal.label>
  <!-- EN: Make a batch of chemfuel by extracting and condensing gas from coal chunks. -->
  <EM_Make_ChemfuelFromCoal.description>Fabriquez un lot de chemfuel en extrayant et en condensant le gaz contenu dans des morceaux de charbon.</EM_Make_ChemfuelFromCoal.description>
  <!-- EN: Refining chemfuel from coal. -->
  <EM_Make_ChemfuelFromCoal.jobString>Raffine du chemfuel à partir de charbon.</EM_Make_ChemfuelFromCoal.jobString>
  
  <!-- EN: make chemfuel from coal (lead) -->
  <EM_Make_ChemfuelFromCoal_Lead.label>fabriquer du chemfuel à partir du charbon (plomb)</EM_Make_ChemfuelFromCoal_Lead.label>
  <!-- EN: Make a batch of lead-based chemfuel by extracting and condensing gas from coal chunks.\n\n<color=#D73333>Warning:</color> Lead makes for a higher yield but causes accumulative lead contamination over time. -->
  <EM_Make_ChemfuelFromCoal_Lead.description>Fabriquez un lot de chemfuel à base de plomb en extrayant et en condensant le gaz des morceaux de charbon.\n\n<color=#D73333>Avertissement :</color> le plomb permet d'obtenir un rendement plus élevé, mais provoque une contamination cumulative au fil du temps.</EM_Make_ChemfuelFromCoal_Lead.description>
  <!-- EN: Refining chemfuel from coal. -->
  <EM_Make_ChemfuelFromCoal_Lead.jobString>Raffine du chemfuel à partir de charbon.</EM_Make_ChemfuelFromCoal_Lead.jobString>
  
  <!-- EN: make chemfuel from wood (lead) -->
  <EM_Make_ChemfuelFromWood_Lead.label>fabriquer du chemfuel à partir de bois (plomb)</EM_Make_ChemfuelFromWood_Lead.label>
  <!-- EN: Make a batch of lead-based chemfuel by extracting and condensing gas from wood logs.\n\n<color=#D73333>Warning:</color> Lead makes for a higher yield but causes accumulative lead contamination over time. -->
  <EM_Make_ChemfuelFromWood_Lead.description>Fabriquez un lot de chemfuel à base de plomb en extrayant et en condensant le gaz des bûches de bois.\n\n<color=#D73333>Avertissement :</color> le plomb permet d'obtenir un rendement plus élevé, mais provoque une contamination cumulative au fil du temps.</EM_Make_ChemfuelFromWood_Lead.description>
  <!-- EN: Refining chemfuel from coal. -->
  <EM_Make_ChemfuelFromWood_Lead.jobString>Raffine du chemfuel à partir de bois.</EM_Make_ChemfuelFromWood_Lead.jobString>
  
