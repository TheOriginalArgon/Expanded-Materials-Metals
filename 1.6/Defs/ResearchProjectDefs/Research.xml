<Defs>

    <!-- Alloy Research -->
    <ResearchProjectDef>
        <defName>EM_SteelWorking</defName>
        <label>steel working</label>
        <description>Make steel from iron and carbon.</description>
        <baseCost>700</baseCost>
        <techLevel>Medieval</techLevel>
        <researchViewX>3.00</researchViewX>
        <researchViewY>4.05</researchViewY>
        <prerequisites>
            <li>Smithing</li>
        </prerequisites>
    </ResearchProjectDef>

    <ResearchProjectDef>
        <defName>EM_TemperedSteelMaking</defName>
        <label>tempered steel</label>
        <description>Make tempered steel, a stronger version of steel made through a chemical process.</description>
        <baseCost>900</baseCost>
        <techLevel>Medieval</techLevel>
        <researchViewX>4.00</researchViewX>
        <researchViewY>3.35</researchViewY>
        <prerequisites>
            <li>EM_SteelWorking</li>
        </prerequisites>
    </ResearchProjectDef>

    <ResearchProjectDef>
        <defName>EM_StainlessSteelMaking</defName>
        <label>stainless steel</label>
        <description>Make stainless steel, a special variant of steel useful in prosthetics and medical supplies.</description>
        <baseCost>1000</baseCost>
        <techLevel>Industrial</techLevel>
        <researchViewX>4.00</researchViewX>
        <researchViewY>4.00</researchViewY>
        <prerequisites>
            <li>EM_SteelWorking</li>
        </prerequisites>
    </ResearchProjectDef>

    <ResearchProjectDef>
        <defName>EM_AdvancedAlloying</defName>
        <label>advanced alloying</label>
        <description>Create complex alloys furnaces that can handle extreme temperatures and high pressure to create cutting-edge materials.</description>
        <baseCost>3500</baseCost>
        <techLevel>Spacer</techLevel>
        <researchViewX>4.00</researchViewX>
        <researchViewY>4.00</researchViewY>
        <prerequisites>
            <li>EM_TemperedSteelMaking</li>
            <li>EM_StainlessSteelMaking</li>
            <li>Electricity</li>
        </prerequisites>
    </ResearchProjectDef>

    <ResearchProjectDef>
        <defName>EM_PlasteelAlloying</defName>
        <label>plasteel alloying</label>
        <description>Learn to create an ultra-durable lightweight alloy that is 98% identical to plasteel at a molecular level.</description>
        <baseCost>4000</baseCost>
        <techLevel>Ultra</techLevel>
        <researchViewX>5.00</researchViewX>
        <researchViewY>4.00</researchViewY>
        <prerequisites>
            <li>EM_AdvancedAlloying</li>
        </prerequisites>
    </ResearchProjectDef>

    <!-- Reverse Alloying -->
    <ResearchProjectDef>
        <defName>EM_ReverseAlloying</defName>
        <label>reverse alloying</label>
        <description>Extract base metals from alloys at a drug lab.</description>
        <baseCost>2300</baseCost>
        <techLevel>Industrial</techLevel>
        <researchViewX>3.00</researchViewX>
        <researchViewY>0.60</researchViewY>
        <prerequisites>
            <li>DrugProduction</li>
        </prerequisites>
    </ResearchProjectDef>

    <!-- Ore Extraction -->
    <ResearchProjectDef>
        <defName>EM_OreExtraction</defName>
        <label>ore extraction</label>
        <description>Extract raw ore from rock chunks at a smelter.</description>
        <baseCost>1500</baseCost>
        <techLevel>Industrial</techLevel>
        <researchViewX>5.00</researchViewX>
        <researchViewY>3.95</researchViewY>
        <prerequisites>
            <li>Smithing</li>
            <li>Electricity</li>
        </prerequisites>
    </ResearchProjectDef>

</Defs>