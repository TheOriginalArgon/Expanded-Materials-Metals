<Defs>

    <!-- ===== STEEL REPLACEMENTS ===== -->
    <MaterialReplacement.Defs.MaterialReplacementDef>
        <defName>EM_Replacement_SteelWithBronze</defName>
        <materialToReplace>Steel</materialToReplace>
        <replaceWith>EM_Bronze</replaceWith>
        <maxTechLevel>Medieval</maxTechLevel>
        <applyToRecipes>false</applyToRecipes>
        <costModifier>1.1</costModifier>
        <exceptionDefs>
            <li>MetalTile</li>
            <li MayRequire="rebuild.cotr.doorsandcorners">RB_MetalGrateTile</li>
            <li MayRequire="rebuild.cotr.doorsandcorners">RB_MetalStuddedTile</li>
            <li MayRequire="vanillaexpanded.vfearchitect,ludeon.rimworld.royalty">VFEArch_FineSteelTile</li>
        </exceptionDefs>
    </MaterialReplacement.Defs.MaterialReplacementDef>

    <MaterialReplacement.Defs.MaterialReplacementDef>
        <defName>EM_Replacement_SteelWithIron</defName>
        <materialToReplace>Steel</materialToReplace>
        <replaceWith>EM_Iron</replaceWith>
        <maxTechLevel>Medieval</maxTechLevel>
        <maxRecipeTechLevel>Medieval</maxRecipeTechLevel>
        <costModifier>1.2</costModifier>
        <exceptionDefs>
            <li>MetalTile</li>
            <li MayRequire="rebuild.cotr.doorsandcorners">RB_MetalGrateTile</li>
            <li MayRequire="rebuild.cotr.doorsandcorners">RB_MetalStuddedTile</li>
            <li MayRequire="vanillaexpanded.vfearchitect,ludeon.rimworld.royalty">VFEArch_FineSteelTile</li>
        </exceptionDefs>
    </MaterialReplacement.Defs.MaterialReplacementDef>

    <MaterialReplacement.Defs.MaterialReplacementDef>
        <defName>EM_Replacement_SteelWithMildSteel</defName>
        <materialToReplace>Steel</materialToReplace>
        <replaceWith>EM_MildSteel</replaceWith>
        <maxTechLevel>Industrial</maxTechLevel>
        <maxRecipeTechLevel>Medieval</maxRecipeTechLevel>
        <costModifier>1.1</costModifier>
    </MaterialReplacement.Defs.MaterialReplacementDef>

    <MaterialReplacement.Defs.MaterialReplacementDef>
        <defName>EM_Replacement_SteelWithTemperedSteel</defName>
        <materialToReplace>Steel</materialToReplace>
        <replaceWith>EM_TemperedSteel</replaceWith>
        <costModifier>0.9</costModifier>
    </MaterialReplacement.Defs.MaterialReplacementDef>

    <!-- ===== PLASTEEL REPLACEMENTS ===== -->

    <MaterialReplacement.Defs.MaterialReplacementDef>
        <defName>EM_Replacement_PlasteelWithTitanium</defName>
        <materialToReplace>Plasteel</materialToReplace>
        <replaceWith>EM_Titanium</replaceWith>
        <maxTechLevel>Industrial</maxTechLevel>
        <maxRecipeTechLevel>Industrial</maxRecipeTechLevel>
        <costModifier>1</costModifier>
    </MaterialReplacement.Defs.MaterialReplacementDef>

</Defs>