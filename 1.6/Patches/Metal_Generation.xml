<Patch>

    <!-- Remove steel generation -->
    <Operation Class="VEF.PatchOperationToggableSequence">
        <enabled>true</enabled>
        <label>Remove vanilla steel generation:</label>
        <operations>
            <li Class="PatchOperationRemove">
                <xpath>/Defs/ThingDef [defName="MineableSteel"]/building/mineableScatterCommonality</xpath>
            </li>
            <li Class="PatchOperationRemove">
                <xpath>/Defs/ThingDef [defName="MineableSteel"]/building/mineableScatterLumpSizeRange</xpath>
            </li>
        </operations>
    </Operation>

    <!-- Remove deep steel generation -->
    <Operation Class="VEF.PatchOperationToggableSequence">
        <enabled>false</enabled>
        <label>Remove vanilla steel deep generation</label>
        <operations>
            <li Class="PatchOperationRemove">
                <xpath>/Defs/ThingDef [defName="Steel"]/deepCommonality</xpath>
            </li>
        </operations>
    </Operation>

    <!-- Remove plasteel generation -->
    <Operation Class="VEF.PatchOperationToggableSequence">
        <enabled>true</enabled>
        <label>Remove vanilla plasteel generation:</label>
        <operations>
            <li Class="PatchOperationRemove">
                <xpath>/Defs/ThingDef [defName="MineablePlasteel"]/building/mineableScatterCommonality</xpath>
            </li>
            <li Class="PatchOperationRemove">
                <xpath>/Defs/ThingDef [defName="MineablePlasteel"]/building/mineableScatterLumpSizeRange</xpath>
            </li>
        </operations>
    </Operation>

    <!-- Remove deep plasteel generation -->
    <Operation Class="VEF.PatchOperationToggableSequence">
        <enabled>false</enabled>
        <label>Remove vanilla plasteel deep generation</label>
        <operations>
            <li Class="PatchOperationRemove">
                <xpath>/Defs/ThingDef [defName="Plasteel"]/deepCommonality</xpath>
            </li>
        </operations>
    </Operation>

    <!-- Remove components generation -->
    <Operation Class="VEF.PatchOperationToggableSequence">
        <enabled>false</enabled>
        <label>Remove vanilla components generation:</label>
        <operations>
            <li Class="PatchOperationRemove">
                <xpath>/Defs/ThingDef [defName="MineableComponentsIndustrial"]/building/mineableScatterCommonality</xpath>
            </li>
            <li Class="PatchOperationRemove">
                <xpath>/Defs/ThingDef [defName="MineableComponentsIndustrial"]/building/mineableScatterLumpSizeRange</xpath>
            </li>
        </operations>
    </Operation>

    <!-- Change mineable steel drop to mild steel -->
    <Operation Class="VEF.PatchOperationToggableSequence">
        <enabled>false</enabled>
        <label>Mineable steel yields mild steel:</label>
        <operations>
            <li Class="PatchOperationReplace">
                <xpath>/Defs/ThingDef [defName="MineableSteel"]/building/mineableThing</xpath>
                <value>
                    <mineableThing>EM_MildSteel</mineableThing>
                </value>
            </li>
        </operations>
    </Operation>

    <!-- Mining sites with new resources -->
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Ideology</li>
        </mods>
        <match Class="PatchOperationReplace">
            <xpath>/Defs/SitePartDef [defName="WorkSite_Mining"]/lootTable/li[thing[text()="Steel"]]</xpath>
            <value>
                <li>
                    <thing>EM_Iron</thing>
                    <weight>0.5</weight>
                </li>
                <li>
                    <thing>EM_Copper</thing>
                    <weight>0.25</weight>
                </li>
                <li>
                    <thing>EM_Titanium</thing>
                    <weight>0.25</weight>
                </li>
            </value>
        </match>
    </Operation>

</Patch>