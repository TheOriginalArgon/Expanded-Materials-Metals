<Defs>

    <ThingDef ParentName="RockBase">
        <defName>EM_Compressed_Coal</defName>
        <label>compressed coal</label>
        <description>Ancient fossilized matter compressed into a dense coal-rich deposit. Found only in deep space.</description>
        <graphicData>
            <texPath>Things/Natural/DeepRockWallFlecked_Atlas</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <color>(115,106,98)</color>
            <colorTwo>(25,29,34)</colorTwo>
        </graphicData>
        <statBases>
            <MaxHitPoints>4500</MaxHitPoints>
        </statBases>
        <building>
            <isResourceRock>true</isResourceRock>
            <mineableThing>EM_Coal</mineableThing>
            <mineableYield>90</mineableYield>
            <mineableScatterCommonality>0</mineableScatterCommonality>
            <mineableScatterLumpSizeRange>
                <min>50</min>
                <max>90</max>
            </mineableScatterLumpSizeRange>
            <veinMineable>true</veinMineable>
            <mineablePreventMeteorite>true</mineablePreventMeteorite>
        </building>
    </ThingDef>

