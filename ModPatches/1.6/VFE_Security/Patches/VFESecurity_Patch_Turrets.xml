<Patch>

    <!-- Add titanium to the ammunition of some turrets -->
    <Operation Class="VEF.PatchOperationToggableSequence">
        <enabled>true</enabled>
        <label>Plasteel-fueled turrets can also be refueled with titanium:</label>
        <operations>
            <li Class="PatchOperationAdd">
                <xpath>/Defs/ThingDef [
                    defName="VFES_Turret_ChargeTurret" or
                    defName="VFES_Turret_ChargeRailgun" or
                    defName="VFES_Complex_Charge"]
                    /comps/li [@Class="CompProperties_Refuelable"]/fuelFilter/thingDefs
                </xpath>
                <value>
                    <li>EM_Titanium</li>
                </value>
            </li>
        </operations>
    </Operation>

    <!-- Turret costs -->
    <Operation Class="ArgonicCore.PatchOperations.PatchOperationDistributeCost">
        <xpath>/Defs/ThingDef [
            defName="VFES_Turret_ChargeTurret" or
            defName="VFES_Turret_ChargeRailgun" or
            defName="VFES_Turret_TeslaBlaster" or
            defName="VFES_Complex_Charge" or
            defName="VFES_SmallRepulsor" or
            defName="VFES_LargeRepulsor"
            ]/costList/Plasteel</xpath>
        <newMaterial>EM_Titanium</newMaterial>
        <percentage>30</percentage>
    </Operation>

</Patch>